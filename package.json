{
  "name": "@bytescale/style-loader",
  "version": "3.3.1-forked.5",
  "description": "style loader module for webpack",
  "license": "MIT",
  "repository": "webpack-contrib/style-loader",
  "author": "Tobias Koppers @sokra",
  "homepage": "https://github.com/webpack-contrib/style-loader",
  "bugs": "https://github.com/webpack-contrib/style-loader/issues",
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/webpack"
  },
  "main": "dist/cjs.js",
  "engines": {
    "node": ">= 12.13.0"
  },
  "scripts": {
    "start": "npm run build -- -w",
    "clean": "del-cli dist",
    "validate:runtime": "es-check es3 \"dist/runtime/**/*.js\"",
    "prebuild": "npm run clean",
    "build": "cross-env NODE_ENV=production babel src -d dist --copy-files",
    "postbuild": "npm run validate:runtime",
    "commitlint": "commitlint --from=master",
    "security": "npm audit --production",
    "lint:prettier": "prettier --list-different .",
    "lint:js": "eslint --cache .",
    "lint": "npm-run-all -l -p \"lint:**\"",
    "test:only": "cross-env NODE_ENV=test jest",
    "test:watch": "npm run test:only -- --watch",
    "test:coverage": "npm run test:only -- --collectCoverageFrom=\"src/**/*.js\" --coverage",
    "test:manual": "npm run build && webpack serve ./test/manual/src/index.js --open --config test/manual/webpack.config.js",
    "pretest": "npm run lint",
    "test": "npm run test:coverage",
    "prepare": "husky install && npm run build",
    "release": "standard-version"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "webpack": "^5.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^16.2.1",
    "@webpack-contrib/eslint-config-webpack": "^3.0.0",
    "babel-jest": "^30.5.2",
    "cross-env": "^7.0.3",
    "css-loader": "^6.6.0",
    "del": "^6.0.0",
    "del-cli": "^4.0.1",
    "es-check": "^9.8.1",
    "eslint": "^8.8.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.25.4",
    "file-loader": "^6.2.0",
    "husky": "^7.0.1",
    "jest": "^30.5.2",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.4.0",
    "memfs": "^3.4.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.5.1",
    "sass": "^1.105.2",
    "sass-loader": "^12.4.0",
    "semver": "^7.3.4",
    "standard-version": "^9.3.1",
    "webpack": "^5.112.0",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "^6.1.0",
    "jest-environment-jsdom": "30.5.2"
  },
  "keywords": [
    "webpack"
  ],
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "glob@>=9 <14.0.2": "14.0.4",
    "minimatch@>=7 <11.0.1": "11.0.5"
  }
}
